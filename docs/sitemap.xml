---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign pages = site.pages | sort: 'url' %}
  {% for entry in pages %}
    {% if entry.redirect_to %}
      {% continue %}
    {% endif %}
    {% if entry.layout == 'site' or entry.layout == 'blog-post' %}
      <url>
        <loc>{{ entry.url | absolute_url | xml_escape }}</loc>
        {% assign updated = entry.updated %}
        {% if entry.layout == 'blog-post' %}
          {% assign updated = updated | default: entry.date %}
        {% endif %}
        {% if updated %}
          <lastmod>{{ updated | date: '%Y-%m-%d' }}</lastmod>
        {% endif %}
      </url>
    {% endif %}
  {% endfor %}
  <url>
    <loc>{{ '/docs/' | absolute_url }}</loc>
  </url>
</urlset>
