 namespace MNN {
 namespace DIFFUSION {
+namespace {
+// Session outputs can alias reusable backend buffers. Copy their materialized values
+// into independent host inputs before another forward or module destruction.
+VARP ownedFloatCopy(VARP source, const std::vector<int>& expected) {
+    if (!source.get()) throw std::runtime_error("Missing MNN tensor");
+    auto converted = _Convert(source, NCHW);
+    auto info = converted->getInfo();
+    if (!info || info->dim != expected || info->type.code != halide_type_float ||
+        info->type.bits != 32 || info->type.lanes != 1) {
+        throw std::runtime_error("Unexpected MNN tensor shape or type");
+    }
+    const auto values = converted->readMap<float>();
+    if (!values) throw std::runtime_error("MNN tensor unavailable");
+    auto copy = _Input(expected, NCHW, halide_type_of<float>());
+    auto destination = copy->writeMap<float>();
+    if (!destination) throw std::runtime_error("MNN tensor copy allocation failed");
+    for (int i = 0; i < info->size; ++i) {
+        if (!std::isfinite(values[i])) throw std::runtime_error("Nonfinite MNN tensor");
+        destination[i] = values[i];
+    }
+    // This only changes the type of an already independently allocated input.
+    if (!copy.fix(VARP::CONSTANT)) throw std::runtime_error("MNN tensor copy failed");
+    return copy;
+}
+
+std::shared_ptr<Module> loadStage(const std::string& root, int index,
+        const std::shared_ptr<Executor::RuntimeManager>& manager, bool useMetalAttention = false) {
+    static const std::vector<std::string> names = {"text_encoder", "unet", "vae_decoder"};
+    static const std::vector<std::vector<std::string>> inputs = {
+        {"input_ids"}, {"sample", "timestep", "encoder_hidden_states"}, {"latent_sample"}
+    };
+    static const std::vector<std::vector<std::string>> outputs = {
+        {"last_hidden_state", "pooler_output"}, {"out_sample"}, {"sample"}
+    };
+    if (index < 0 || index >= names.size()) throw std::runtime_error("Invalid MNN stage");
+    Module::Config config;
+    config.shapeMutable = false;
+    MNN_PRINT("SDAI MNN stage=%s; stageLoading=true; unetBatch=1\n", names[index].c_str());
+    std::shared_ptr<Module> module;
+    const auto path = root + "/" + names[index] + ".mnn";
+    if (index == 1) {
+        std::ifstream stream(path, std::ios::binary | std::ios::ate);
+        if (!stream || stream.tellg() != 1353144) throw std::runtime_error("Pinned UNet graph unavailable");
+        std::vector<uint8_t> original(1353144);
+        stream.seekg(0);
+        if (!stream.read(reinterpret_cast<char*>(original.data()), original.size())) {
+            throw std::runtime_error("Pinned UNet graph read failed");
+        }
+        auto optimized = useMetalAttention ? sdai::boundPinnedMetalAttention(original)
+            : sdai::scalarizePinnedUnetBiases(original);
+        manager->setExternalFile(path + ".weight");
+        try {
+            module.reset(Module::load(inputs[index], outputs[index], optimized.data(), optimized.size(), manager, &config));
+        } catch (...) {
+            manager->setExternalFile("");
+            throw;
+        }
+        manager->setExternalFile("");
+        MNN_PRINT("SDAI MNN stage=unet; scalarZeroBiases=32; metalBoundedAttention=%d; originalWeights=true\n", useMetalAttention ? 32 : 0);
+    } else {
+        module.reset(Module::load(inputs[index], outputs[index], path.c_str(), manager, &config));
+    }
+    if (!module) throw std::runtime_error("MNN stage loading failed");
+    MNN_PRINT("SDAI MNN stage=%s; stageLoaded=true\n", names[index].c_str());
+    return module;
+}
+}
 
